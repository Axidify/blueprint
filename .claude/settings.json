  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),fs=require('fs'),cp=require('child_process');const r=process.env.CLAUDE_PROJECT_DIR||process.cwd();const f=p.join(r,'tools','status.py');if(!fs.existsSync(f))process.exit(0);const w=process.platform==='win32';const v=p.join(r,'.venv',w?'Scripts':'bin',w?'python.exe':'python');const py=process.env.BLUEPRINT_PYTHON||(fs.existsSync(v)?v:(w?'python':'python3'));const x=cp.spawnSync(py,['-I',f,'--brief'],{stdio:'inherit'});process.exit(x.status===null?1:x.status)\"",
            "timeout": 30,
            "statusMessage": "Loading Blueprint status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node -e \"const p=require('path'),fs=require('fs'),cp=require('child_process');const r=process.env.CLAUDE_PROJECT_DIR||process.cwd();const f=p.join(r,'tools','check_docs.py');if(!fs.existsSync(f))process.exit(0);const w=process.platform==='win32';const v=p.join(r,'.venv',w?'Scripts':'bin',w?'python.exe':'python');const py=process.env.BLUEPRINT_PYTHON||(fs.existsSync(v)?v:(w?'python':'python3'));const x=cp.spawnSync(py,['-I',f,'--hook'],{stdio:'inherit'});process.exit(x.status===null?1:x.status)\"",
            "timeout": 60,
            "statusMessage": "Checking docs and changelog"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "node -e \"const p=require('path'),fs=require('fs'),cp=require('child_process');const r=process.env.CLAUDE_PROJECT_DIR||process.cwd();const f=p.join(r,'tools','check_docs.py');if(!fs.existsSync(f))process.exit(0);const w=process.platform==='win32';const v=p.join(r,'.venv',w?'Scripts':'bin',w?'python.exe':'python');const py=process.env.BLUEPRINT_PYTHON||(fs.existsSync(v)?v:(w?'python':'python3'));const x=cp.spawnSync(py,['-I',f,'--hook'],{stdio:'inherit'});process.exit(x.status===null?1:x.status)\"",
            "timeout": 60,
            "statusMessage": "Checking docs and changelog"
          }
        ]
      }
    ]
  }
