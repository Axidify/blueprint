{
  "permissions": {
    "allow": [
      "Bash(python -I tools/extract.py *)",
      "Bash(python -I tools/register.py *)",
      "Bash(python -I tools/mockup.py *)",
      "Bash(python -I tools/generate_requirements.py *)",
      "Bash(python -I tools/status.py *)",
      "Bash(python -I tools/status.py)",
      "Bash(python -I tools/doctor.py)",
      "Bash(python -I tools/new_project.py *)",
      "Bash(node tools/screenshot.mjs *)",
      "Bash(npm install *)",
      "Bash(npm install)",
      "PowerShell(python -I tools/extract.py *)",
      "PowerShell(python -I tools/register.py *)",
      "PowerShell(python -I tools/mockup.py *)",
      "PowerShell(python -I tools/generate_requirements.py *)",
      "PowerShell(python -I tools/status.py *)",
      "PowerShell(python -I tools/status.py)",
      "PowerShell(python -I tools/doctor.py)",
      "PowerShell(python -I tools/new_project.py *)",
      "PowerShell(node tools/screenshot.mjs *)",
      "PowerShell(npm install *)",
      "PowerShell(npm install)",
      "Edit(projects/**)",
      "Edit(inbox/**)",
      "Edit(knowledge/**)",
      "Bash(python -I tools/project.py *)",
      "PowerShell(python -I tools/project.py *)",
      "Bash(python -I tools/document_format.py *)",
      "PowerShell(python -I tools/document_format.py *)",
      "Bash(python -I tools/check_docs.py *)",
      "Bash(python -I tools/check_docs.py)",
      "PowerShell(python -I tools/check_docs.py *)",
      "PowerShell(python -I tools/check_docs.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -c \"import os,sys,runpy;f=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'tools','status.py');sys.argv=[f,'--brief'];runpy.run_path(f,run_name='__main__') if os.path.exists(f) else sys.exit(0)\"",
            "timeout": 30,
            "statusMessage": "Loading Blueprint status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python -I -c \"import os,sys,runpy;f=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'tools','check_docs.py');sys.argv=[f,'--hook'];runpy.run_path(f,run_name='__main__') if os.path.exists(f) else sys.exit(0)\"",
            "timeout": 60,
            "statusMessage": "Checking docs and changelog"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "python -I -c \"import os,sys,runpy;f=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'tools','check_docs.py');sys.argv=[f,'--hook'];runpy.run_path(f,run_name='__main__') if os.path.exists(f) else sys.exit(0)\"",
            "timeout": 60,
            "statusMessage": "Checking docs and changelog"
          }
        ]
      }
    ]
  }
}
